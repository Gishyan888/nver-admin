{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/specs_sync.py\" hook"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/specs_sync.py\" prompt"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(python3 .claude/specs_sync.py*)",
      "Bash(python3 specs/team/devlog.py *)",
      "Bash(python3 specs/team/result.py *)",
      "Bash(python3 specs/team/status.py *)"
    ]
  }
}
